@model ChatViewModel
@{
    ViewData["Title"] = "Czat";
}

<div id="chatContainer" class="d-flex vh-85" style="margin: 0; padding: 0;">
    <!-- Users List - Reduced Width -->
    <div id="userList" class="bg-light p-2 overflow-auto border-end" style="width: 200px;">
        <h5 class="fw-bold mb-3">Użytkownicy</h5>
        <div id="users" class="d-flex flex-column gap-2"></div>
    </div>

    <!-- Main Chat Area - Expanded Width -->
    <div id="chatBox" class="flex-grow-1 d-flex flex-column p-2" style="width: 60%;">
        <input type="hidden" id="userId" value="@Model.UserId" />
        <h4 id="chatHeader" class="mb-3">Wybierz użytkownika</h4>

        <div class="mb-3 d-flex gap-2">
            <input type="text" id="searchInput" class="form-control" placeholder="Szukaj wiadomości...">
            <button id="searchButton" class="btn btn-primary">Szukaj</button>
            <button id="pinnedButton" class="btn btn-warning">📌 Przypięte</button>
        </div>
        <ul id="pinnedMessages" class="list-group mb-3 d-none"></ul>

        <ul id="searchResults" class="list-group mb-3"></ul>
        <button id="closeSearchResults" class="btn btn-sm btn-secondary mt-2 d-none">Zamknij</button>

        <div id="messages" class="flex-grow-1 overflow-auto border rounded p-3 bg-light mb-3"></div>

        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2">
                <div class="d-flex align-items-center flex-grow-1 position-relative">
                    <input type="text" id="messageInput"
                           class="form-control flex-grow-1 me-2"
                           placeholder="Wpisz wiadomość..." />

                    <button id="emojiButton" class="btn btn-light flex-shrink-0">
                        😀
                    </button>

                    <div id="emojiPicker" class="emoji-container border rounded bg-white p-2 mt-1"
                         style="display: none; position: absolute; bottom: 100%; right: 0; z-index: 100;">
                        @foreach (var emoji in Model.Emojis)
                        {
                            <span class="emoji" style="cursor: pointer; font-size: 20px; margin: 5px;">@emoji</span>
                        }
                    </div>
                </div>
                <button id="sendButton" class="btn btn-primary">Wyślij</button>

            </div>

            <div class="d-flex align-items-center gap-2">
                <button id="gifButton" class="btn btn-light">GIF</button>
                <div id="gifSearchContainer" class="d-flex align-items-center gap-2 mt-2 d-none">
                    <input type="text" id="gifSearchInput" class="form-control" placeholder="Szukaj GIF-a..." />
                </div>
                <!-- Trigger Button -->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#locationModal">
                    📍
                </button>

                <!-- Modal -->
                <div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="locationModalLabel">Choose a Location</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div id="map" style="height: 400px; width: 100%;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                <button type="button" id="confirmLocation" class="btn btn-primary">Send This Location</button>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="file" id="attachmentInput" class="form-control form-control-sm flex-grow-1" />
            </div>


            <div id="gifResults" class="border rounded bg-white p-2 mt-2 overflow-auto" style="max-height: 200px; display: none;"></div>

        </div>
    </div>

    <!-- Friends List - Reduced Width -->
    <div id="friendList" class="bg-light p-2 overflow-auto border-start" style="width: 300px;">
        <h5 class="fw-bold mb-3">Znajomi</h5>
        <ul id="friends" class="list-group"></ul>
        <button id="startGroupChatBtn" class="btn btn-primary my-2">
            <i class="bi bi-people-fill"></i> Stwórz czat grupowy
        </button>
        <ul id="friends" class="list-group"></ul>



        <div id="groupChatForm" class="card p-3 mt-3 d-none">
            <div class="mb-2">
                <label for="groupChatName" class="form-label">Nazwa grupy</label>
                <input type="text" id="groupChatName" class="form-control" placeholder="Wpisz nazwę grupy">
            </div>
            <button id="createGroupBtn" class="btn btn-success">Utwórz grupę</button>
            <button id="cancelGroupBtn" class="btn btn-secondary ms-2">Anuluj</button>
        </div>

        <h5 class="mt-4">Czaty grupowe</h5>
        <ul id="groupChats" class="list-group"></ul>

    </div>

    <!-- Friend Requests - Reduced Width -->
    <div id="requestsContainer" class="bg-light p-2 overflow-auto border-start" style="width: 200px;">
        <h5 class="fw-bold mb-3">Zaproszenia</h5>
        <div id="requests" class="d-flex flex-column gap-2"></div>
    </div>

    <div class="modal fade" id="groupSettingsModal" tabindex="-1" aria-labelledby="groupSettingsLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="groupSettingsLabel">Ustawienia grupy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    <ul id="groupMembersList" class="list-group mb-3"></ul>
                    <div class="input-group">
                        <div class="mb-3">
                            <label for="inviteUserSearch" class="form-label">Zaproś znajomego</label>
                            <input type="text" class="form-control" id="inviteUserSearch" placeholder="Wyszukaj znajomego...">
                            <div id="inviteUserResults" class="list-group mt-2"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script type="module" src="~/js/main.js?v=@DateTime.UtcNow.Ticks"></script>
<script type="module" src="~/js/darkmode.js?v=@DateTime.UtcNow.Ticks"></script>
<link href="~/css/chat.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
