@model UNChat.Models.RegisterViewModel

@{
    ViewData["Title"] = "Rejestracja";
}

<h2>Zarejestruj się</h2>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-0 p-2">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

<form asp-action="Register" method="post">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control form-control-sm" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control form-control-sm" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-control form-control-sm" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Zarejestruj się</button>
</form>

<p>Masz już konto? <a asp-action="Login">Zaloguj się</a></p>
