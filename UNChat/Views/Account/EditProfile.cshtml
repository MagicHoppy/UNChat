@model UNChat.Models.EditProfileViewModel

@{
    ViewData["Title"] = "Edytuj profil";
}

<div class="container py-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="EditProfile" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    </form>
    <hr />
    <h4>Klucz API</h4>

    @if (User.Identity.IsAuthenticated)
    {
        if (Model.ApiKey != null)
        {
            <div class="mb-2">
                <code>@Model.ApiKey</code>
            </div>
            <form asp-action="GenerateApiKey" method="post">
                <button type="submit" class="btn btn-warning">Wygeneruj ponownie</button>
            </form>
        }
        else
        {
            <form asp-action="GenerateApiKey" method="post">
                <button type="submit" class="btn btn-success">Wygeneruj klucz API</button>
            </form>
        }
    }

</div>

@section Scripts {
    <link href="~/css/chat.css" rel="stylesheet" />
    <script type="module" src="~/js/darkmode.js?v=@DateTime.UtcNow.Ticks"></script>
    <partial name="_ValidationScriptsPartial" />
}
